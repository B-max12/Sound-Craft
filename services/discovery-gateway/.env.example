# SoundCraft Discovery Gateway — environment template.
# Copy to .env (NEVER commit the real .env — root .gitignore blocks it).
# YouTube Data API v3 key from https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Optional: restrict CORS to your app/web origins (comma-separated). Default: *
ALLOWED_ORIGINS=*
# Optional: port for local dev server. Default: 8787
PORT=8787
